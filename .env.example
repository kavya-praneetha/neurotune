# Copy this file to `.env` and fill in the values you need.
# `.env` is gitignored and never enters the Docker image — docker-compose
# injects it at runtime, so keys stay out of every published layer.
#
#   cp .env.example .env
#
# NOTHING in neurotune/ needs a key. The whole EEG -> recommendation ->
# explanation pipeline runs offline on simulated data:
#
#   uv run python -m neurotune.cli run-all --subjects 3 --sessions 2
#
# The keys below are only for the agent examples in agents/.

# Required by agents/hello_agent.py (a tool-using Claude agent).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Only needed if you swap an example over to an OpenAI model.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Local models via Ollama need NO key — agents/local_llm.py talks to
# http://localhost:11434 directly. See the README for the Docker caveat.
